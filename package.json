{
  "name": "phantomdesk",
  "version": "1.1.1",
  "description": "PhantomDesk Elite — High-Performance Remote Control",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "dev:app": "electron .",
    "build": "electron-builder",
    "rebuild": "electron-rebuild -f -w koffi"
  },
  "author": "PhantomDesk Global",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "koffi": "^2.9.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.phantomdesk.elite",
    "productName": "PhantomDesk Elite",
    "copyright": "Copyright © 2026 PhantomDesk Global",
    "asar": false,
    "compression": "store",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "src/assets/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "PhantomDesk_Elite_Edition_${version}.${ext}"
    }
  }
}
